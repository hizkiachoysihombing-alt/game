# Frontend Environment Configuration

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# Authentication
NEXT_PUBLIC_JWT_EXPIRY=1800000
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRY=604800000

# Feature Flags
NEXT_PUBLIC_ENABLE_GAMIFICATION=true
NEXT_PUBLIC_ENABLE_CIRCUIT_LAB=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_COMMUNITY=false

# Gamification Settings (display only, values from backend)
NEXT_PUBLIC_FREE_PLAN_DAILY_ENERGY=10
NEXT_PUBLIC_PREMIUM_DAILY_ENERGY=unlimited

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# Stripe (for displaying pricing, actual processing on backend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App Configuration
NEXT_PUBLIC_APP_NAME=ElectroQuest
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

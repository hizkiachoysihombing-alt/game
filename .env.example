# ElectroQuest Environment Configuration

# Application
APP_ENV=development
DEBUG=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
BACKEND_URL=http://backend:8000
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database
DATABASE_URL=postgresql://electroquest:electroquest_dev@postgres:5432/electroquest_db
POSTGRES_USER=electroquest
POSTGRES_PASSWORD=electroquest_dev
POSTGRES_DB=electroquest_db

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (for password reset, notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@electroquest.com

# Billing & Subscription (Stripe)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_secret_here

# Redis (optional, for caching and background tasks)
REDIS_URL=redis://redis:6379/0

# Learning Energy (Free plan)
FREE_PLAN_DAILY_ENERGY=10
FREE_PLAN_ENERGY_RESET_HOUR=0  # UTC hour (0-23)

# Gamification
BASE_XP_EASY=10
BASE_XP_MEDIUM=20
BASE_XP_HARD=35
BASE_XP_CHALLENGE=60
LEVEL_UP_FORMULA=exponential  # exponential or linear
LEVEL_UP_FACTOR=1.5

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Sentry (error tracking)
SENTRY_DSN=

# AWS S3 (for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=electroquest-content
AWS_REGION=us-east-1

# Private learning-source storage. Keep local files and credentials out of Git.
SOURCE_STORAGE_BACKEND=local
SOURCE_LOCAL_ROOT=./source_storage
SOURCE_MATERIALS_ROOT=./source_materials
SOURCE_MAX_UPLOAD_BYTES=52428800
SOURCE_IMPORT_LEGACY=true
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional AI question drafting. AI output always enters human review as a draft.
OPENAI_API_KEY=
OPENAI_MODEL=

# Feature Flags
ENABLE_CIRCUIT_LAB=false
ENABLE_SINGLE_LINE_DIAGRAM=false
ENABLE_POWER_FLOW=false
ENABLE_FAULT_ANALYSIS=false
ENABLE_AI_TUTOR=false

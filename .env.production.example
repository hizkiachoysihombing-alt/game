# Copy to .env.production and replace every CHANGE_ME value.
DATABASE_URL=postgresql+psycopg://electroquest:CHANGE_ME@postgres-host:5432/electroquest
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
SECRET_KEY=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
BACKEND_WORKERS=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SOURCE_STORAGE_BACKEND=local
SOURCE_MAX_UPLOAD_BYTES=52428800
SOURCE_IMPORT_LEGACY=true
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

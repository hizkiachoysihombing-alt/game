# Copy to .env.production and replace every CHANGE_ME value.
DATABASE_URL=postgresql+psycopg://electroquest:CHANGE_ME@postgres-host:5432/electroquest
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD
SECRET_KEY=CHANGE_ME_AT_LEAST_64_RANDOM_CHARACTERS
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
BACKEND_WORKERS=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
